// Prisma schema — Presupuestador Inteligente KEVS
// Modelo de datos basado en PRD.md secciones 3-12.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  MXN
  EUR
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  ARCHIVED
  PAID
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum UserRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  DONE
}

enum EventType {
  MEETING
  DELIVERY
  REVIEW
  PAYMENT
  REMINDER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

/// Cuenta de usuario del estudio. id coincide con el id de Supabase Auth (auth.users.id).
/// MVP: un solo usuario (Kevs, ADMIN). El campo role existe desde ya para soportar
/// los 2 usuarios adicionales previstos sin necesitar una migración futura.
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  avatarUrl   String?  @db.Text
  role        UserRole @default(ADMIN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes   Quote[]
  projects Project[]
  events   Event[]

  @@map("users")
}

/// Cliente del estudio — compartido por Presupuestos IA (que solo lee/escribe
/// name/company/defaultCurrency, vía process-budget-request.ts) y por el
/// módulo Clientes (CRM del dashboard principal), que además usa
/// firstName/lastName/country/address/website/status. "name" se mantiene
/// como nombre completo sincronizado (nunca se quita ni se renombra) para no
/// romper Presupuestos IA, que depende de él en PDFs, chat y actividad.
model Client {
  id              String       @id @default(uuid())
  name            String
  firstName       String?
  lastName        String?
  company         String?
  email           String?
  phone           String?
  country         String?
  address         String?
  website         String?
  defaultCurrency Currency?
  status          ClientStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  quotes Quote[]
  events Event[]

  @@index([name])
  @@index([company])
  @@map("clients")
}

/// Servicio del catálogo (webs, diseño de redes, fotografía, etc.).
/// Editable por el usuario desde la app, sin intervención de desarrollo.
model Service {
  id          String   @id @default(uuid())
  /// Identificador estable para servicios del catálogo oficial (p. ej. "SOCIAL_POST"),
  /// usado por el motor de precios para no depender de coincidencias de texto.
  code        String?  @unique
  name        String
  category    String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pricingRules   PricingRule[]
  discountRules  DiscountRule[]
  quoteLineItems QuoteLineItem[]

  @@map("services")
}

/// Tramo de descuento por volumen para un servicio (mismos tramos en todas las monedas).
model DiscountRule {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minQty    Int
  /// Nulo = "o más" (sin límite superior del tramo).
  maxQty    Int?
  percent   Decimal @db.Decimal(5, 2)

  @@unique([serviceId, minQty])
  @@map("discount_rules")
}

/// Precio de referencia de un servicio para un mercado/moneda específico.
/// No es una conversión de divisa: cada moneda tiene su propio precio base,
/// que la IA puede sugerir/actualizar investigando el mercado actual (PRD 5 y 10).
model PricingRule {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  currency  Currency
  basePrice Decimal  @db.Decimal(10, 2)
  unitLabel String?
  notes     String?
  updatedAt DateTime @updatedAt

  @@unique([serviceId, currency])
  @@map("pricing_rules")
}

/// Presupuesto. Se crea como borrador vacío al iniciar la conversación y se va
/// completando incrementalmente; guarda el resultado final, la explicación del
/// cálculo y el copy de venta que se incluyen en el PDF (PRD 4, 8 y 10).
model Quote {
  id       String  @id @default(uuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  /// Nulos hasta que la IA los determina vía set_client (a partir del país).
  currency       Currency?
  taxRatePercent Decimal?    @db.Decimal(5, 2)
  status         QuoteStatus @default(DRAFT)

  /// Respuestas del cuestionario guiado por servicio (estructura dinámica).
  questionnaireAnswers Json?

  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)
  discountReason String?
  taxAmount      Decimal      @default(0) @db.Decimal(10, 2)
  total          Decimal      @default(0) @db.Decimal(10, 2)

  /// Explicación en lenguaje claro de cómo se calculó el precio (uso interno / opcional en PDF).
  calculationExplanation String? @db.Text
  /// Descripción persuasiva del servicio para el PDF ("vender", no solo listar precio).
  salesDescription       String? @db.Text
  termsAndConditions     String? @db.Text
  deliveryTimeline       String?

  issuedAt   DateTime  @default(now())
  validUntil DateTime?

  /// Sellados por updateQuoteStatus() la primera vez que el estado llega a
  /// ese punto (no se sobrescriben en cambios posteriores). Alimentan la
  /// tarjeta "Seguimiento" del panel derecho.
  sentAt     DateTime?
  approvedAt DateTime?
  paidAt     DateTime?

  /// Fecha principal para ubicar el presupuesto en la Agenda. Si es nula, la
  /// Agenda usa createdAt como respaldo. No hay editor todavía — se lee tal
  /// cual quede sembrado (manualmente por ahora).
  followUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems     QuoteLineItem[]
  statusHistory QuoteStatusHistory[]
  messages      ConversationMessage[]
  notes         QuoteNote[]

  @@map("quotes")
}

/// Nota interna del estudio (bitácora, no un solo campo de texto) — nunca se
/// incluye en el PDF del cliente.
model QuoteNote {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quote_notes")
}

/// Turno de texto legible de la conversación guiada de un presupuesto.
/// No guarda las llamadas a herramientas de Gemini (functionCall/functionResponse):
/// el estado real vive en Quote/Client/QuoteLineItem, así que al reabrir un
/// presupuesto basta con este historial de texto para dar contexto a la IA.
model ConversationMessage {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// "user" | "model" (mismos valores de rol que usa la API de Gemini).
  role    String
  content String @db.Text

  createdAt DateTime @default(now())

  @@map("conversation_messages")
}

/// Línea individual del desglose del presupuesto.
model QuoteLineItem {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  /// % de descuento por volumen aplicado a esta línea (catálogo oficial). Nulo si no aplica.
  discountPercent Decimal? @db.Decimal(5, 2)
  sortOrder   Int     @default(0)

  @@map("quote_line_items")
}

/// Auditoría de cambios de estado de un presupuesto (Borrador -> Enviado -> Aceptado/Rechazado).
model QuoteStatusHistory {
  id        String      @id @default(uuid())
  quoteId   String
  quote     Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status    QuoteStatus
  note      String?
  changedAt DateTime    @default(now())

  @@map("quote_status_history")
}

/// Proyecto del módulo Proyectos (dashboard principal) — independiente del
/// módulo Presupuestos IA, sin relación con Quote/Client. "client" y "owner"
/// son texto libre porque todavía no existen los módulos reales de Clientes
/// ni Equipo (ambos siguen siendo placeholders "Próximamente").
model Project {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  client      String
  type        String?
  description String?       @db.Text
  owner       String?
  dueDate     DateTime?
  progress    Int           @default(0)
  status      ProjectStatus @default(NOT_STARTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  events Event[]

  @@map("projects")
}

/// Evento de la Agenda comercial (dashboard principal) — independiente de la
/// agenda interna de Presupuestos IA (que se deriva de Quote.followUpDate).
/// Reutiliza Client y Project por id (ambos opcionales) en vez de duplicar
/// esos datos.
model Event {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      EventType @default(MEETING)
  startAt   DateTime
  endAt     DateTime
  location  String?
  notes     String?   @db.Text
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("events")
}
