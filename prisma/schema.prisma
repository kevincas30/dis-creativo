// Prisma schema — Presupuestador Inteligente KEVS
// Modelo de datos basado en PRD.md secciones 3-12.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  MXN
  EUR
}

enum QuoteStatus {
  DRAFT
  READY_TO_SEND
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  ARCHIVED
  PAID
}

enum DepositKind {
  PERCENTAGE
  FIXED
  FULL
  NONE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum UserRole {
  ADMIN
  MEMBER
}

/// Rol de una persona dentro de un workspace compartido. Sustituirá de forma
/// gradual a User.role como fuente de autorización durante la Fase 0.
enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  DONE
  DELIVERED
  CLOSED
  PAUSED
  CANCELLED
}

enum ProjectKind {
  ONE_OFF
  RECURRING
}

enum RelationshipStatus {
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

enum WorkItemKind {
  TASK
  DELIVERABLE
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
}

enum EventType {
  MEETING
  DELIVERY
  REVIEW
  PAYMENT
  REMINDER
  FOLLOW_UP
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ClientStage {
  PROSPECT
  CLIENT
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUOTE
  WON
  LOST
}

enum LeadSource {
  INSTAGRAM
  WHATSAPP
  REFERRAL
  DIRECT
  OTHER
}

/// Cuenta de usuario del estudio. id coincide con el id de Supabase Auth (auth.users.id).
/// MVP: un solo usuario (Kevs, ADMIN). El campo role existe desde ya para soportar
/// los 2 usuarios adicionales previstos sin necesitar una migración futura.
model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  avatarUrl   String?  @db.Text
  role        UserRole @default(ADMIN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes             Quote[]
  projects           Project[]
  events             Event[]
  assignments        WorkAssignment[]
  recordedPayments   Payment[]
  activityRecords    ActivityRecord[]
  workspaceMembers   WorkspaceMember[]
  responsibleClients Client[]             @relation("ClientResponsible")
  responsibleQuotes  Quote[]              @relation("QuoteResponsible")
  quoteStatusChanges QuoteStatusHistory[] @relation("QuoteStatusChangedBy")

  @@map("users")
}

/// Espacio compartido del estudio. La primera migración lo mantiene aislado de
/// los datos históricos: las entidades existentes tendrán workspaceId opcional
/// hasta completar el backfill de la Fase 0B.
model Workspace {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  clients         Client[]
  services        Service[]
  quotes          Quote[]
  projects        Project[]
  workItems       WorkItem[]
  events          Event[]
  activityRecords ActivityRecord[]

  @@map("workspaces")
}

/// Membresía y rol de un usuario dentro de un workspace. No hay selección de
/// workspace todavía: los helpers exigen una única membresía activa por usuario.
model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// Cliente del estudio — compartido por Presupuestos IA (que solo lee/escribe
/// name/company/defaultCurrency, vía process-budget-request.ts) y por el
/// módulo Clientes (CRM del dashboard principal), que además usa
/// firstName/lastName/country/address/website/status. "name" se mantiene
/// como nombre completo sincronizado (nunca se quita ni se renombra) para no
/// romper Presupuestos IA, que depende de él en PDFs, chat y actividad.
model Client {
  id                  String         @id @default(uuid())
  workspaceId         String?
  workspace           Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                String
  firstName           String?
  lastName            String?
  company             String?
  email               String?
  phone               String?
  country             String?
  address             String?
  website             String?
  defaultCurrency     Currency?
  status              ClientStatus   @default(ACTIVE)
  stage               ClientStage    @default(CLIENT)
  prospectStatus      ProspectStatus @default(WON)
  source              LeadSource?
  responsibleId       String?
  responsible         User?          @relation("ClientResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  instagram           String?
  emailNormalized     String?
  phoneNormalized     String?
  instagramNormalized String?
  convertedAt         DateTime?
  nextFollowUpEventId String?        @unique
  nextFollowUpEvent   Event?         @relation("ClientFollowUp", fields: [nextFollowUpEventId], references: [id], onDelete: SetNull)
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  quotes          Quote[]
  events          Event[]          @relation("ClientEvents")
  archivedAt      DateTime?
  projects        Project[]
  activityRecords ActivityRecord[]

  @@index([name])
  @@index([company])
  @@index([workspaceId])
  @@index([workspaceId, emailNormalized])
  @@index([workspaceId, phoneNormalized])
  @@index([workspaceId, instagramNormalized])
  @@index([workspaceId, responsibleId])
  @@index([workspaceId, stage, prospectStatus])
  @@map("clients")
}

/// Servicio del catálogo (webs, diseño de redes, fotografía, etc.).
/// Editable por el usuario desde la app, sin intervención de desarrollo.
model Service {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// Identificador estable para servicios del catálogo oficial (p. ej. "SOCIAL_POST"),
  /// usado por el motor de precios para no depender de coincidencias de texto.
  code        String?    @unique
  name        String
  category    String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  pricingRules   PricingRule[]
  discountRules  DiscountRule[]
  quoteLineItems QuoteLineItem[]

  @@index([workspaceId])
  @@map("services")
}

/// Tramo de descuento por volumen para un servicio (mismos tramos en todas las monedas).
model DiscountRule {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  minQty    Int
  /// Nulo = "o más" (sin límite superior del tramo).
  maxQty    Int?
  percent   Decimal @db.Decimal(5, 2)

  @@unique([serviceId, minQty])
  @@map("discount_rules")
}

/// Precio de referencia de un servicio para un mercado/moneda específico.
/// No es una conversión de divisa: cada moneda tiene su propio precio base,
/// que la IA puede sugerir/actualizar investigando el mercado actual (PRD 5 y 10).
model PricingRule {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  currency  Currency
  basePrice Decimal  @db.Decimal(10, 2)
  unitLabel String?
  notes     String?
  updatedAt DateTime @updatedAt

  @@unique([serviceId, currency])
  @@map("pricing_rules")
}

/// Presupuesto. Se crea como borrador vacío al iniciar la conversación y se va
/// completando incrementalmente; guarda el resultado final, la explicación del
/// cálculo y el copy de venta que se incluyen en el PDF (PRD 4, 8 y 10).
model Quote {
  id            String     @id @default(uuid())
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  responsibleId String?
  responsible   User?      @relation("QuoteResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)

  /// Nulos hasta que la IA los determina vía set_client (a partir del país).
  currency       Currency?
  taxRatePercent Decimal?    @db.Decimal(5, 2)
  status         QuoteStatus @default(DRAFT)

  /// Respuestas del cuestionario guiado por servicio (estructura dinámica).
  questionnaireAnswers Json?

  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?      @db.Decimal(10, 2)
  discountReason String?
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  depositKind    DepositKind   @default(PERCENTAGE)
  /// Valor editable del anticipo: porcentaje, importe fijo, total o cero según depositKind.
  depositValue   Decimal       @default(50) @db.Decimal(10, 2)

  /// Explicación en lenguaje claro de cómo se calculó el precio (uso interno / opcional en PDF).
  calculationExplanation String? @db.Text
  /// Descripción persuasiva del servicio para el PDF ("vender", no solo listar precio).
  salesDescription       String? @db.Text
  termsAndConditions     String? @db.Text
  deliveryTimeline       String?

  issuedAt   DateTime  @default(now())
  validUntil DateTime?

  /// Sellados por updateQuoteStatus() la primera vez que el estado llega a
  /// ese punto (no se sobrescriben en cambios posteriores). Alimentan la
  /// tarjeta "Seguimiento" del panel derecho.
  sentAt     DateTime?
  approvedAt DateTime?
  paidAt     DateTime?

  /// Fecha principal para ubicar el presupuesto en la Agenda. Si es nula, la
  /// Agenda usa createdAt como respaldo. No hay editor todavía — se lee tal
  /// cual quede sembrado (manualmente por ahora).
  followUpDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  lineItems     QuoteLineItem[]
  statusHistory QuoteStatusHistory[]
  messages      ConversationMessage[]
  notes         QuoteNote[]
  events        Event[]

  @@index([workspaceId])
  @@map("quotes")
}

/// Nota interna del estudio (bitácora, no un solo campo de texto) — nunca se
/// incluye en el PDF del cliente.
model QuoteNote {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quote_notes")
}

/// Turno de texto legible de la conversación guiada de un presupuesto.
/// No guarda las llamadas a herramientas de Gemini (functionCall/functionResponse):
/// el estado real vive en Quote/Client/QuoteLineItem, así que al reabrir un
/// presupuesto basta con este historial de texto para dar contexto a la IA.
model ConversationMessage {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// "user" | "model" (mismos valores de rol que usa la API de Gemini).
  role    String
  content String @db.Text

  createdAt DateTime @default(now())

  @@map("conversation_messages")
}

/// Línea individual del desglose del presupuesto.
model QuoteLineItem {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  description     String
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice       Decimal  @db.Decimal(10, 2)
  lineTotal       Decimal  @db.Decimal(10, 2)
  /// % de descuento por volumen aplicado a esta línea (catálogo oficial). Nulo si no aplica.
  discountPercent Decimal? @db.Decimal(5, 2)
  sortOrder       Int      @default(0)

  @@map("quote_line_items")
}

/// Auditoría de cambios de estado de un presupuesto (Borrador -> Enviado -> Aceptado/Rechazado).
model QuoteStatusHistory {
  id          String      @id @default(uuid())
  quoteId     String
  quote       Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status      QuoteStatus
  note        String?
  changedAt   DateTime    @default(now())
  changedById String?
  changedBy   User?       @relation("QuoteStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@map("quote_status_history")
}

/// Proyecto del módulo Proyectos (dashboard principal) — independiente del
/// módulo Presupuestos IA, sin relación con Quote/Client. "client" y "owner"
/// son texto libre porque todavía no existen los módulos reales de Clientes
/// ni Equipo (ambos siguen siendo placeholders "Próximamente").
model Project {
  id          String        @id @default(uuid())
  workspaceId String?
  workspace   Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  client      String
  type        String?
  description String?       @db.Text
  owner       String?
  dueDate     DateTime?
  progress    Int           @default(0)
  status      ProjectStatus @default(NOT_STARTED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  kind               ProjectKind        @default(ONE_OFF)
  relationshipStatus RelationshipStatus @default(ACTIVE)
  clientId           String?
  clientRecord       Client?            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quoteId            String?
  quote              Quote?             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  agreedTotal        Decimal?           @db.Decimal(12, 2)
  currency           Currency?
  paymentDueDate     DateTime?          @db.Date
  periods            ProjectPeriod[]
  payments           Payment[]
  workItems          WorkItem[]
  assignments        WorkAssignment[]
  activityRecords    ActivityRecord[]
  events             Event[]

  @@index([clientId])
  @@index([quoteId])
  @@index([workspaceId])
  @@map("projects")
}

/// Evento de la Agenda comercial (dashboard principal) — independiente de la
/// agenda interna de Presupuestos IA (que se deriva de Quote.followUpDate).
/// Reutiliza Client y Project por id (ambos opcionales) en vez de duplicar
/// esos datos.
model Event {
  id                String         @id @default(uuid())
  workspaceId       String?
  workspace         Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  type              EventType      @default(MEETING)
  startAt           DateTime
  endAt             DateTime
  location          String?
  notes             String?        @db.Text
  clientId          String?
  client            Client?        @relation("ClientEvents", fields: [clientId], references: [id], onDelete: SetNull)
  followUpForClient Client?        @relation("ClientFollowUp")
  quoteId           String?
  quote             Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  periodId          String?
  period            ProjectPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([workspaceId])
  @@index([quoteId])
  @@map("events")
}

model ProjectPeriod {
  id              String           @id @default(uuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  label           String
  startDate       DateTime         @db.Date
  dueDate         DateTime?        @db.Date
  status          ProjectStatus    @default(NOT_STARTED)
  agreedTotal     Decimal?         @db.Decimal(12, 2)
  currency        Currency?
  paymentDueDate  DateTime?        @db.Date
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  payments        Payment[]
  workItems       WorkItem[]
  assignments     WorkAssignment[]
  activityRecords ActivityRecord[]
  events          Event[]

  @@unique([projectId, startDate])
  @@unique([id, projectId])
  @@map("project_periods")
}

model Payment {
  id           String         @id @default(uuid())
  requestId    String         @unique
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  periodId     String?
  period       ProjectPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  amount       Decimal        @db.Decimal(12, 2)
  currency     Currency
  paidAt       DateTime       @db.Date
  note         String?
  recordedById String
  recordedBy   User           @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())

  @@index([projectId, periodId])
  @@map("payments")
}

model WorkItem {
  id          String         @id @default(uuid())
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  periodId    String?
  period      ProjectPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  title       String
  kind        WorkItemKind   @default(TASK)
  priority    WorkPriority   @default(NORMAL)
  dueDate     DateTime?      @db.Date
  recurring   Boolean        @default(false)
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([projectId, periodId])
  @@index([workspaceId])
  @@map("work_items")
}

model WorkAssignment {
  id        String         @id @default(uuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  periodId  String?
  period    ProjectPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())

  @@unique([projectId, periodId, userId])
  @@map("work_assignments")
}

model ActivityRecord {
  id          String         @id @default(uuid())
  workspaceId String?
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorId     String
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  projectId   String?
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  periodId    String?
  period      ProjectPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  action      String
  description String
  createdAt   DateTime       @default(now())

  @@index([projectId, periodId, createdAt])
  @@index([clientId, createdAt])
  @@index([workspaceId])
  @@map("activity_records")
}
