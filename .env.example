# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env (con valores reales) a git — ya está en .gitignore.

# --- Supabase ---
# Panel de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_ANON_PUBLIC_KEY"

# --- Base de datos (Postgres de Supabase) ---
# Panel de Supabase: Project Settings -> Database -> Connection string
# DATABASE_URL: connection pooling (Transaction mode), puerto 6543. La usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexión directa, puerto 5432. La usa el CLI de Prisma para migraciones (prisma migrate).
DIRECT_URL="postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- IA (Google Gemini) ---
# Chat que arma presupuestos: busca/crea clientes, consulta el catálogo y genera el presupuesto.
# Obtén tu clave en https://aistudio.google.com/apikey
GEMINI_API_KEY="AI..."
